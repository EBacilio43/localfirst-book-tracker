# BaciBooks — Variables de Entorno de Ejemplo
# Copia este archivo a .env y completa los valores necesarios para tu entorno local.

# Supabase (Catálogo Global y Sync Híbrido)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Google Gemini API (Búsqueda Inteligente - Desarrollo local)
EXPO_PUBLIC_GEMINI_API_KEY=tu-gemini-api-key-aqui

# Google Books API (Opcional, para aumentar cuota de desarrollo)
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=tu-google-books-api-key
