# BaciBooks — Variables de Entorno de Ejemplo
# Copia este archivo a .env y completa los valores necesarios para tu entorno local.

# Supabase (Catalogo Global de ISBNs y Sync Hibrido)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Proxy Seguro para Gemini API (Supabase Edge Function en produccion)
EXPO_PUBLIC_GEMINI_EDGE_PROXY_URL=https://tu-proyecto.supabase.co/functions/v1/gemini-proxy

# Google Drive (Respaldo privado del usuario en appDataFolder)
EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# Google Gemini API (Busqueda Inteligente - Solo para desarrollo local directo)
EXPO_PUBLIC_GEMINI_API_KEY=tu-gemini-api-key-aqui

# Google Books API (Opcional, para aumentar cuota de desarrollo)
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=tu-google-books-api-key
